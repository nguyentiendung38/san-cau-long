# Environment
NODE_ENV=development

# Database
DATABASE_URL="postgresql://courtify:courtify123@localhost:5432/courtify_dev?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Cors
CORS_ORIGIN="http://localhost:5173"

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# SMTP email delivery for portal registration and password-reset OTPs
# Gmail: use smtp.gmail.com, port 465, secure=true, and a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
