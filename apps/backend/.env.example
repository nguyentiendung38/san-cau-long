NODE_ENV=development
DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-jwt-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
FRONTEND_URL="http://localhost:5173"
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
# Use the callback URL registered with your VNPay Sandbox account.
VNPAY_RETURN_URL=""
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# SMTP email delivery for portal registration and password-reset OTPs
# Gmail: use smtp.gmail.com, port 465, secure=true, and a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Production: set DATABASE_URL, two different JWT secrets (32+ characters),
# and comma-separated HTTPS origins for the admin web and deployed Zalo Mini App.
